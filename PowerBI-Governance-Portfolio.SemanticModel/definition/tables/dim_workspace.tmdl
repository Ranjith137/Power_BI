	column environment
		dataType: string
		lineageTag: 6a2d43f5-47cb-47df-b1e0-d101a2330e7d
		summarizeBy: none
		sourceColumn: environment

		annotation SummarizationSetBy = Automatic

	column 'Active Admin Count' =
			
			CALCULATE (
			    COUNTROWS ( bridge_workspace_access ),
			    bridge_workspace_access[role] = "Admin",
			    bridge_workspace_access[is_account_enabled] = 1
			)
		formatString: 0
		lineageTag: bf6b51ba-707c-44d8-bca5-727f6a4178bb
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Is Orphaned' =
			
			IF (
			    dim_workspace[state] = "Active"
			        && dim_workspace[Active Admin Count] = 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: a0f3f770-b2d6-4442-a8ff-93fc3affda85
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

